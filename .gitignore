# ==============================================================================
# HYT-MLFXBG .gitignore
# ==============================================================================

# 1. 运行期仿真数据与切片缓存目录 (避免上传大体积图像数据)
temp/
/temp/

# 2. 生成的大体积 PowerPoint 报告文件 (*.pptx)
# 例外: 仅 templates/ 下的**当前母版**入库 (可移植性契约, report_config 以相对路径引用)
#       templates/Moldflow报告模板_1.pptx 是历史备份 (17MB), 不入库
*.pptx
!templates/Moldflow报告模板.pptx

# 3. Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# 4. 运行日志文件
*.log
run.log
temp/*.log

# 5. 系统与操作系统生成的文件
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# 6. 编辑器与 IDE 配置
.vscode/
.idea/
.zcode/
*.sublime-project
*.sublime-workspace

# 7. 本地缓存与 AI 助手工作目录 (个人数据, 单人项目不入库; CI 侧门禁独立于这些目录)
.ruff_cache/
.workbuddy/

# 同步器机器记录（契约约定不入库）
.agents/.source
