# ==============================================================================
# HYT-MLFXBG .gitignore
# ==============================================================================

# 1. 运行期仿真数据与切片缓存目录 (避免上传大体积图像数据)
temp/
/temp/

# 2. 生成的大体积 PowerPoint 报告文件 (*.pptx)
*.pptx

# 3. Python 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# 4. 运行日志文件
*.log
run.log
temp/*.log

# 5. 系统与操作系统生成的文件
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# 6. 编辑器与 IDE 配置
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
